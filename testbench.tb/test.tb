module tb;
  reg [3:0]in;
  reg clk,ld,rst;
  wire [1:0]light;
  fsm uut(in,clk,light,rst,ld);
 initial begin 
   clk=0;
   forever begin
     #1 clk=~clk;
   end
 end
  initial begin
    
      $monitor($time,"count=%d,light=%b,ld=%d",uut.count,light,ld);
      in=4'b0000;ld=1;
      #5 ld=0;rst=0;
      //#100 rst=1;
   
  end
  initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0,tb);
    
   #200$finish;
  end
endmodule
